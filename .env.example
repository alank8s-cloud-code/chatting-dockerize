# This file lives NEXT TO docker-compose.yml (project root) - it is a
# DIFFERENT file from backend/.env. docker-compose automatically reads a
# file named ".env" in the same folder as docker-compose.yml, and uses it
# to fill in ${VARIABLE} references inside docker-compose.yml itself.
#
# backend/.env  -> environment variables INSIDE the backend/database containers
#                  (JWT secret, DB credentials, CORS origins, etc.)
# .env (this one) -> variables used by docker-compose itself, at BUILD time,
#                     before any container even starts.

# Where the browser should reach the backend API from.
# Defaults to http://localhost:8080 if this file/variable doesn't exist -
# fine for testing on one machine. Set this to your real domain/IP when
# deploying somewhere the frontend and backend aren't both "localhost".
REACT_APP_API_URL=http://localhost:8080
